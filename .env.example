VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"
# AI gateway (OpenAI-compatible)
AI_GATEWAY_URL="https://api.openai.com/v1"
AI_API_KEY="sk-..."
AI_MODEL="gpt-4o-mini"
FALLBACK_MODELS="gpt-4o-mini,gpt-4o"
MAX_TOOL_ROUNDS="6"
MAX_HISTORY_MESSAGES="30"
ALLOWED_ORIGINS="http://localhost:8080,https://yourdomain.com"
# MCP — set a strong random token for external agents
MCP_API_KEY="change-me-to-a-long-random-token"
# Edge functions also need SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# Free-model failover chain (FINESE-chat): configure any subset — the chain
# skips providers with no key. More keys = more failover depth.
# GROQ_API_KEY="gsk-..."
# CEREBRAS_API_KEY="csk-..."
# OPENROUTER_API_KEY="sk-or-..."
# GOOGLE_API_KEY="AIza..."
# NVIDIA_API_KEY="nvapi-..."

# Frontend optional
# VITE_OFFLINE_PREVIEW=true — when true, shows explicit "Offline preview (local compute)" banner instead of Verified badge when AI gateway unreachable
VITE_OFFLINE_PREVIEW="true"
# Admin allow-list (emails only — NEVER passwords). These addresses are treated
# as admin by useAuth when their Supabase user lacks the is_admin claim.
# Provision the accounts with: npm run admin:ensure (reads ADMIN1_PASSWORD /
# ADMIN2_PASSWORD + SUPABASE_SERVICE_ROLE_KEY from env — passwords never in repo).
VITE_ADMIN_EMAILS="finese_admin@gmail.com,admin@finese.ai"
# Single-user local mode — run the whole app with no Supabase project.
# "Continue locally" button on /auth (no password), uploads/compute/chat run
# in-browser against localStorage. DEFAULT FALSE. NEVER enable on shared
# hosting — it replaces real authentication with a one-click local session.
VITE_LOCAL_MODE="false"
